# ==============================================================================
# Multi-Agent Trading System - environment configuration
# Copy this file to .env and adjust. Never commit the real .env file.
# ==============================================================================

# --- AI (OpenRouter, optional) -------------------------------------------------
# Leave OPENROUTER_API_KEY empty to run fully deterministic (no LLM calls).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# ALWAYS | ON_SIGNAL | ON_CONFLICT | MANUAL
LLM_CALL_MODE=ON_SIGNAL
OPENROUTER_TIMEOUT=30
LLM_MAX_RETRIES=2

# --- Database -------------------------------------------------------------------
# SQLite by default (zero setup). PostgreSQL URL also supported:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/trading
DATABASE_URL=sqlite:///./trading.db

# --- Trading mode ---------------------------------------------------------------
PAPER_TRADING=true
LIVE_TRADING=false

# --- Defaults -------------------------------------------------------------------
DEFAULT_SYMBOL=XAUUSD
DEFAULT_TIMEFRAME=4h

# --- Risk limits (deterministic, enforced by the Risk Engine) -------------------
MAX_RISK_PER_TRADE=0.004
MAX_DAILY_LOSS=0.012
MAX_CONSECUTIVE_LOSSES=3
MAX_OPEN_POSITIONS=3
MIN_RISK_REWARD=2.0
MAX_POSITION_SIZE=50000
MAX_SYMBOL_EXPOSURE=0.5
MAX_TOTAL_EXPOSURE=1.0
MAX_SPREAD_PCT=0.0015
MAX_DATA_AGE_MINUTES=120
ENFORCE_MARKET_HOURS=false
NEWS_BLACKOUT_MINUTES=30

# --- Position sizing ------------------------------------------------------------
RISK_PERCENTAGE=0.004

# --- Paper account / execution model --------------------------------------------
PAPER_ACCOUNT_BALANCE=10000
PAPER_COMMISSION=0.0005
PAPER_SLIPPAGE=0.0002
PAPER_SPREAD_PCT=0.0002

# --- Decision engine agent weights ----------------------------------------------
TECHNICAL_WEIGHT=1.0
QUANT_WEIGHT=0.8
STRATEGY_WEIGHT=1.5
REGIME_WEIGHT=0.6
NEWS_WEIGHT=0.4
SENTIMENT_WEIGHT=0.3
DECISION_THRESHOLD=0.35

# --- Strategy parameters (liquidity sweep -> MSS/BOS -> displacement -> entry) ---
SWING_LOOKBACK=3
SWEEP_MAX_AGE=20
DISPLACEMENT_REQUIRED=true
DISPLACEMENT_ATR=1.2
STOP_BUFFER_ATR=0.25

# --- Market data ----------------------------------------------------------------
# local = files in data/raw + database; stooq = free daily data; twelvedata = opt-in intraday polling
MARKET_DATA_PROVIDER=local
POLLING_INTERVAL=60
TWELVE_DATA_API_KEY=
CACHE_TTL_OHLCV=300
CACHE_TTL_NEWS=900
CACHE_TTL_LLM=86400

# --- Twelve Data credit model (Phase 35) -----------------------------------------
# Credit-aware rate limiting: per-endpoint costs + documented response headers.
TWELVEDATA_MINUTE_LIMIT=8
TWELVEDATA_DAILY_LIMIT=800
TWELVEDATA_DEFAULT_CREDIT_COST=1
TWELVEDATA_TIME_SERIES_CREDIT_COST=1
TWELVEDATA_QUOTE_CREDIT_COST=1
TWELVEDATA_SYMBOL_SEARCH_CREDIT_COST=1
TWELVEDATA_API_USAGE_CREDIT_COST=1
# /api_usage itself consumes a credit; only called explicitly or on startup sync.
TWELVEDATA_API_USAGE_ENDPOINT=/api_usage
TWELVEDATA_API_USAGE_CACHE_SECONDS=300
TWELVEDATA_API_USAGE_MAX_INTERVAL_SEC=3600

# --- Real-market session (Phase 38) ----------------------------------------------
REALMARKET_PAUSE_ON_PROVIDER_FAILURE=true
REALMARKET_STALE_AFTER_SEC=600

# --- News (optional). Comma-separated RSS feed URLs. Empty = news unavailable. ---
NEWS_RSS_URLS=

# --- Misc -----------------------------------------------------------------------
ENV=development
DEBUG=false
# CORS origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Minimum sample size before agent performance statistics are considered reliable
MIN_AGENT_SAMPLE_SIZE=50
